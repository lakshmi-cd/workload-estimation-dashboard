<mvc:View controllerName="workloadestimationmodel.controller.WorkloadEstimationmodel"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="Workload Estimation Dashboard">
        <content>

            <Panel headerText="Estimate Workload from Switch Count" class="sapUiSmallMarginBottom">
                <VBox class="sapUiSmallMargin">
                    <Label text="Number of Switches" labelFor="switchInput"/>
                    <Input id="switchInput" type="Number" width="200px" placeholder="e.g. 12"/>
                    <Button text="Calculate" type="Emphasized" press="onCalculate" class="sapUiTinyMarginTop"/>

                    <ObjectStatus
                        visible="{result>/hasResult}"
                        class="sapUiSmallMarginTop"
                        title="Result"
                        text="Size: {result>/sizeCategory}  |  Total Days: {result>/totalDays}  |  Total Hours: {result>/totalHours}"
                        state="Success"/>

                    <Text visible="{result>/hasError}" text="Please enter a valid number of switches." class="sapUiTinyMarginTop"/>
                </VBox>
            </Panel>

            <Table items="{data>/Sizes}">
                <columns>
                    <Column><Text text="Station Size"/></Column>
                    <Column hAlign="End"><Text text="Generic Documentation"/></Column>
                    <Column hAlign="End"><Text text="Per Station"/></Column>
                    <Column hAlign="End"><Text text="Release after MAD Review"/></Column>
                    <Column hAlign="End"><Text text="Infra Preparation"/></Column>
                    <Column hAlign="End"><Text text="Review &amp; Release"/></Column>
                    <Column hAlign="End"><Text text="Total (Days)"/></Column>
                    <Column hAlign="End"><Text text="Total (Hours)"/></Column>
                    <Column hAlign="End"><Text text="€ / Hour"/></Column>
                    <Column hAlign="End"><Text text="Estimated Cost (€)"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{data>SizeCategory}"/>
                            <Text text="{data>GenericDocumentation}"/>
                            <Text text="{data>PerStation}"/>
                            <Text text="{data>ReleaseAfterMAD}"/>
                            <Text text="{data>InfraPreparation}"/>
                            <Text text="{data>ReviewRelease}"/>
                            <Text text="{data>TotalDays}"/>
                            <Text text="{data>TotalHours}"/>
                            <Input type="Number" width="90px" value="{data>EuroPerHour}"/>
                            <Text text="{= Number(${data>TotalHours}) * Number(${data>EuroPerHour}) }"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

            <Panel headerText="Station Size Classification (based on number of switches)" class="sapUiSmallMarginTop">
                <Table items="{data>/SizeLogic}">
                    <columns>
                        <Column><Text text="Size"/></Column>
                        <Column><Text text="Switch Count Range"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{data>SizeCategory}"/>
                                <Text text="{data>SwitchRange}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>

        </content>
    </Page>
</mvc:View>